# ─── Postgram ────────────────────────────────────────────────────────────────
# Your Postgram instance and an API key that can read/write tasks.
POSTGRAM_URL=https://postgram.example.com
POSTGRAM_API_KEY=

# ─── Authentication ──────────────────────────────────────────────────────────
# AUTH_MODE: password (default) | proxy | cosmos | oidc | dev (local only)
AUTH_MODE=password

# Signs session cookies for password and oidc mode. Generate: openssl rand -hex 32
SESSION_SECRET=
# Days a login stays valid (default 30)
# SESSION_DAYS=30

# password mode — one user. Create the hash with: npm run hash-password
# Keep the single quotes: the hash contains $ characters.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=''
# AUTH_PASSWORD= (plain text alternative, min. 12 chars; prefer AUTH_PASSWORD_HASH)
# Session cookies are always Secure except on localhost; set COOKIE_INSECURE=true only to test over plain http
# COOKIE_INSECURE=false
# Set to true when a reverse proxy sets X-Forwarded-For (used for login rate limiting)
# TRUST_PROXY=false

# proxy mode — a reverse proxy (Authelia, Authentik, oauth2-proxy, Caddy/Traefik forward-auth)
# logs the user in and forwards a user header plus a shared secret header.
# AUTH_MODE=proxy
# PROXY_USER_HEADER=remote-user
# PROXY_SECRET_HEADER=x-proxy-secret
# PROXY_SECRET=          # openssl rand -hex 32, configured identically in the proxy
# ALLOWED_USERS=alice,bob
# PROXY_LOGIN_PATH=/api/login
#
# cosmos mode — preset for Cosmos Cloud (user header x-cosmos-user); needs PROXY_SECRET and ALLOWED_USERS.

# oidc mode — log in with an OpenID Connect provider (Authentik, Keycloak, Google, …)
# AUTH_MODE=oidc
# OIDC_ISSUER=https://auth.example.com/application/o/taskgram/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://taskgram.example.com/auth/oidc/callback
# OIDC_SCOPES=openid profile email
# OIDC_USER_CLAIM=email
# ALLOWED_USERS=alice@example.com

# ─── Push notifications (optional) ───────────────────────────────────────────
# Generate a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── Server ──────────────────────────────────────────────────────────────────
# Time zone for the daily digest and reminders
APP_TIMEZONE=Europe/Amsterdam
# Where push subscriptions and settings are stored (Docker image: /app/data)
# DATA_DIR=./data
PORT=3000
